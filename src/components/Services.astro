---
import { site } from '../data/site';
---
<section id="servicos" class="section services">
  <header class="wrap sec-head">
    <p class="kicker" data-reveal>[ 01 ] &nbsp;CAPACIDADES</p>
    <h2 class="display" data-reveal>O que entregamos</h2>
    <p class="lead" data-reveal>Da engenharia de projeto ao equipamento rodando em campo — um único responsável técnico, do diagnóstico à manutenção.</p>
  </header>

  <div class="wrap svc-grid">
    {site.services.map((s) => (
      <article class="svc" data-reveal>
        <span class="svc__code mono">{s.code}</span>
        <span class="svc__mark" aria-hidden="true"></span>
        <h3>{s.title}</h3>
        <p>{s.desc}</p>
      </article>
    ))}
  </div>
</section>
