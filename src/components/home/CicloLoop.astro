---
// Ciclo-loop: the ONE horizontal pin of the site (second cinematic moment).
// Desktop: the section pins (home.ts [data-pin]) and the wide [data-pin-track]
// translates horizontally, walking the operator through the closed control loop
// (SENSOR -> CLP -> SCADA -> ATUADOR -> malha fechada) over a control-room
// backdrop. Mobile / reduced-motion (.is-native): no pin, the track reflows into
// a vertical sequence of nodes that reveal on the normal scroll.
import DMark from './DMark.astro';
import { copy } from '../../data/home';

const s = copy['ciclo-loop'];

// each loopNode arrives as "NAME / role"; split into the two voices.
const nodes = (s.loopNodes as string[]).map((n, i) => {
  const [name, role = ''] = n.split(' / ');
  return { etapa: `ETAPA ${String(i + 1).padStart(2, '0')}`, name, role };
});

// hud tags carry their own honesty label "(ILUSTRATIVO)"; peel it off so the
// live status can ignite and the illustrative flag reads as a discrete badge.
const hud = (s.hudTags as string[]).map((t) => {
  const live = /MALHA FECHADA/i.test(t);
  const at = t.indexOf('(ILUSTRATIVO)');
  return { label: at >= 0 ? t.slice(0, at).trim() : t, illus: at >= 0, live };
});

const bgAlt =
  'Engenheiro da Módulo em painel de controle e automação industrial durante o loop-check, com o supervisório na tela.';
---
<section id="loop" class="loop" data-pin aria-labelledby="loop-title">
  <!-- desktop: full-bleed control-room backdrop · mobile: leading image module -->
  <div class="loop__bg">
    <img
      class="loop__img"
      src="/assets/img/controle-automacao.webp"
      srcset="/assets/img/controle-automacao-900.webp 900w, /assets/img/controle-automacao.webp 1600w"
      sizes="(max-width: 900px) 92vw, 60vw"
      alt={bgAlt}
      loading="lazy"
      decoding="async"
      width="1600"
      height="1000"
    />
    <span class="loop__grade" aria-hidden="true"></span>

    <!-- DET balloon: leader on the mother angle pointing at the panel's red button -->
    <div class="loop__det" aria-hidden="true">
      <span class="loop__det-pt"></span>
      <span class="loop__det-tag u-mono"><b>DET A</b> botão crítico, comando de campo</span>
    </div>

    <span class="loop__cap u-mono">Controle e automação, loop-check em campo</span>
  </div>

  <div class="loop__track" data-pin-track>
    <!-- car 1: the read-this-first panel, framed in instrument L-corners -->
    <header class="loop__intro lcorners lcorners--ember">
      <p class="u-kicker loop__kicker" data-reveal><i></i>{s.kicker}</p>
      <h2 id="loop-title" class="loop__title u-display" data-reveal>{s.headline}</h2>
      <p class="loop__lede" data-reveal>{s.explanation}</p>
    </header>

    <!-- car 2: the closed loop, four modules stitched by a trace -->
    <div class="loop__flow" role="list" aria-label="Malha de controle, do sensor ao atuador">
      {nodes.map((n, i) => (
        <>
          <article
            class="loop__node"
            class:list={[i % 2 === 1 && 'loop__node--tr']}
            role="listitem"
            data-reveal
          >
            <i class="loop__ticks" aria-hidden="true"></i>
            <span class="loop__node-etapa u-mono">{n.etapa}</span>
            <span class="loop__node-name u-display">{n.name}</span>
            <span class="loop__node-role">{n.role}</span>
          </article>
          <span class="loop__link" aria-hidden="true"><i></i></span>
        </>
      ))}

      <!-- the loop closes: malha fechada, feedback back to the field -->
      <div class="loop__loopback" role="listitem" data-reveal>
        <span class="loop__loopback-top">
          <i class="loop__live" aria-hidden="true"></i>
          <DMark label="Módulo, malha fechada" />
        </span>
        <span class="loop__loopback-txt u-mono u-ember">Malha fechada</span>
        <span class="loop__loopback-sub u-mono">realimenta o campo</span>
      </div>
    </div>

    <!-- car 3: partida assistida + illustrative HUD readout + closing statement -->
    <aside class="loop__panel" data-reveal>
      <p class="loop__panel-lead">{s.startupLine}</p>
      <ul class="loop__hud">
        {hud.map((h) => (
          <li class="loop__hud-item" class:list={[h.live && 'is-live']}>
            <i aria-hidden="true"></i>
            <span class="loop__hud-label">{h.label}</span>
            {h.illus && <span class="u-illus loop__hud-illus">ilustrativo</span>}
          </li>
        ))}
      </ul>
      <p class="loop__closing u-slab">{s.closingLine}</p>
    </aside>
  </div>
</section>

<style>
  /* ============================================================
     BASE = mobile-first vertical reflow. Also the static fallback
     for .is-native (touch / reduced-motion) and for no-JS.
     ============================================================ */
  .loop{
    position:relative;background:var(--bg);
    padding-block:var(--sec);
    padding-inline:max(var(--pad),env(safe-area-inset-left)) max(var(--pad),env(safe-area-inset-right));
    overflow:hidden;
  }

  /* leading image module (chamfered, never a plain rectangle) */
  .loop__bg{
    position:relative;z-index:0;
    width:100%;max-width:var(--maxw);margin-inline:auto;
    aspect-ratio:16/10;background:var(--surface);overflow:hidden;
    clip-path:var(--clip-chf);
    margin-bottom:clamp(2rem,7vw,3.2rem);
    box-shadow:inset 0 1px 0 rgba(236,238,241,.06);
  }
  .loop__img{
    width:100%;height:100%;object-fit:cover;object-position:52% 44%;
    /* new-source photo: kept almost full colour, only a light graphite grade */
    filter:saturate(.9) contrast(1.03) brightness(.94);
  }
  .loop__grade{
    position:absolute;inset:0;pointer-events:none;background:
      linear-gradient(180deg,rgba(8,10,12,.34) 0%,transparent 24%,transparent 52%,rgba(8,10,12,.82) 100%),
      linear-gradient(90deg,rgba(8,10,12,.5) 0%,transparent 42%);
  }
  .loop__cap{
    position:absolute;left:clamp(14px,3vw,20px);bottom:clamp(14px,3vw,20px);z-index:3;
    font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);
    max-width:70%;
  }

  /* DET balloon: the single ignite over the photo, on the mother angle */
  .loop__det{position:absolute;z-index:4;top:36%;right:16%;pointer-events:none}
  .loop__det-pt{
    position:absolute;top:0;left:0;width:12px;height:12px;background:var(--accent);
    clip-path:var(--clip-diamond);box-shadow:0 0 12px 2px rgba(var(--accent-rgb),.55);
  }
  .loop__det::before{
    content:"";position:absolute;top:6px;left:6px;width:30px;height:1px;background:var(--accent);
    transform-origin:left center;transform:rotate(45deg);opacity:.6;
  }
  .loop__det-tag{
    position:absolute;top:26px;left:26px;white-space:nowrap;
    font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink);
    padding:.35rem .55rem;background:rgba(11,13,15,.8);
    clip-path:var(--clip-chf);--chf:8px;border:var(--hair) solid var(--line);
  }
  .loop__det-tag b{color:var(--accent);font-weight:600;margin-right:.25rem}

  /* the track: vertical stack of the three cars on mobile */
  .loop__track{
    position:relative;z-index:2;
    width:100%;max-width:var(--maxw);margin-inline:auto;
    display:flex;flex-direction:column;gap:clamp(1.8rem,5vw,2.6rem);
  }

  /* car 1: intro */
  .loop__intro{padding:clamp(16px,4vw,26px)}
  .loop__kicker{color:var(--ink);margin-bottom:1rem}
  .loop__title{
    font-size:clamp(1.9rem,5.4vw,3rem);line-height:1.02;letter-spacing:-.02em;
    color:var(--ink);text-wrap:balance;max-width:20ch;
  }
  .loop__lede{
    margin-top:1.1rem;color:var(--muted);
    font-size:clamp(1rem,1.1vw,1.14rem);line-height:1.6;max-width:52ch;
  }

  /* car 2: the loop flow (mobile: vertical chain) */
  .loop__flow{display:flex;flex-direction:column;gap:0}

  .loop__node{
    position:relative;display:flex;align-items:center;gap:1rem;
    padding:1.05rem 1.2rem;background:var(--surface);border:var(--hair) solid var(--line);
    clip-path:var(--clip-chf);--chf:16px;
    box-shadow:inset 0 1px 0 rgba(236,238,241,.05);
    transition:border-color .3s var(--ease),box-shadow .3s var(--ease);
  }
  .loop__node--tr{clip-path:var(--clip-chf-tr)}
  .loop__node-etapa{flex:0 0 auto;font-size:.6rem;color:var(--muted)}
  .loop__node-name{flex:0 0 auto;font-size:1.5rem;line-height:1;color:var(--ink)}
  .loop__node-role{margin-left:auto;text-align:right;color:var(--muted);font-size:.86rem;line-height:1.35}

  /* L-corner instrument ticks on the two intact corners of the chamfer */
  .loop__ticks{position:absolute;inset:0;pointer-events:none}
  .loop__ticks::before,.loop__ticks::after{content:"";position:absolute;width:15px;height:15px}
  .loop__ticks::before{top:9px;right:9px;border-top:var(--hair) solid var(--line);border-right:var(--hair) solid var(--line)}
  .loop__ticks::after{bottom:9px;left:9px;border-bottom:var(--hair) solid var(--line);border-left:var(--hair) solid var(--line)}
  .loop__node--tr .loop__ticks::before{right:auto;left:9px;border-right:none;border-left:var(--hair) solid var(--line)}
  .loop__node--tr .loop__ticks::after{left:auto;right:9px;border-left:none;border-right:var(--hair) solid var(--line)}

  /* hover: the node lifts, its border and instrument ticks ignite, the name glows */
  @media (hover:hover) and (pointer:fine){
    .loop__node{transition:border-color .3s var(--ease),box-shadow .3s var(--ease),transform .4s var(--ease)}
    .loop__ticks::before,.loop__ticks::after{transition:border-color .35s var(--ease)}
    .loop__node-name{transition:color .3s var(--ease)}
    .loop__node:hover{border-color:var(--accent);transform:translateY(-3px)}
    .loop__node:hover .loop__ticks::before,.loop__node:hover .loop__ticks::after{border-color:var(--accent)}
    .loop__node:hover .loop__node-name{color:var(--accent-hi)}
  }

  /* connector trace between nodes (mobile: short vertical segment) */
  .loop__link{
    flex:0 0 auto;align-self:center;position:relative;
    width:100%;height:clamp(24px,5vw,44px);display:grid;place-items:center;
  }
  .loop__link::before{
    content:"";position:absolute;top:0;bottom:0;width:1px;
    background:linear-gradient(180deg,var(--line),var(--muted-dim),var(--line));
  }
  .loop__link i{
    position:relative;z-index:1;width:8px;height:8px;background:var(--surface-2);
    border:1px solid var(--muted-dim);transform:rotate(45deg);
  }

  /* the closed-loop status */
  .loop__loopback{
    position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:.55rem;
    padding:1.15rem 1.3rem;background:var(--surface);border:var(--hair) solid var(--line);
    clip-path:var(--clip-chf);--chf:18px;
    box-shadow:0 0 26px rgba(var(--accent-rgb),.1),inset 0 1px 0 rgba(236,238,241,.05);
  }
  .loop__loopback-top{display:inline-flex;align-items:center;gap:.7rem}
  .loop__loopback-top :global(.dmark){width:32px;height:30px}
  .loop__live{
    width:8px;height:8px;background:var(--accent);clip-path:var(--clip-diamond);
    box-shadow:0 0 0 0 rgba(var(--accent-rgb),.55);animation:loopPulse 1.9s var(--ease) infinite;
  }
  @keyframes loopPulse{
    0%{box-shadow:0 0 0 0 rgba(var(--accent-rgb),.55)}
    70%{box-shadow:0 0 0 9px rgba(var(--accent-rgb),0)}
    100%{box-shadow:0 0 0 0 rgba(var(--accent-rgb),0)}
  }
  /* "Malha fechada" sits on --surface: lift the ember to accent-hi for AA */
  .loop__loopback-txt{font-size:.8rem;letter-spacing:.1em;text-transform:uppercase}
  .loop__loopback-txt.u-ember{color:var(--accent-hi)}
  .loop__loopback-sub{font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}

  /* car 3: panel */
  .loop__panel{
    position:relative;background:var(--surface);border:var(--hair) solid var(--line);
    clip-path:var(--clip-chf-tr);--chf:22px;
    padding:clamp(1.4rem,4vw,2rem);display:flex;flex-direction:column;gap:1.1rem;
    box-shadow:inset 0 1px 0 rgba(236,238,241,.05);
  }
  .loop__panel-lead{color:var(--ink);font-size:clamp(1rem,1.1vw,1.12rem);line-height:1.55;max-width:46ch}
  .loop__hud{
    list-style:none;display:flex;flex-direction:column;gap:.55rem;
    border-top:var(--hair) solid var(--line);border-bottom:var(--hair) solid var(--line);
    padding:.9rem 0;
  }
  .loop__hud-item{
    display:flex;align-items:center;gap:.6rem;
    font-family:var(--mono);font-weight:500;font-size:.68rem;letter-spacing:.1em;
    text-transform:uppercase;color:var(--muted);
  }
  .loop__hud-item i{width:6px;height:6px;background:var(--muted-dim);clip-path:var(--clip-diamond);flex:none}
  .loop__hud-item.is-live{color:var(--accent)}
  .loop__hud-item.is-live i{background:var(--accent);box-shadow:0 0 8px rgba(var(--accent-rgb),.6)}
  .loop__hud-illus{margin-left:.4rem}
  .loop__closing{
    font-size:clamp(1.1rem,1.6vw,1.4rem);line-height:1.3;color:var(--ink);max-width:36ch;
  }

  /* touch: no hover ignite, comfortable targets */
  @media (hover:hover) and (pointer:fine){
    .loop__node:hover{border-color:var(--accent);box-shadow:0 0 24px rgba(var(--accent-rgb),.14),inset 0 1px 0 rgba(236,238,241,.05)}
    .loop__node:hover .loop__ticks::before,
    .loop__node:hover .loop__ticks::after{border-color:var(--accent)}
  }
  @media (pointer:coarse){
    .loop__node{min-height:44px}
  }
  /* reflow (base, sem pin): a foto é um módulo estreito. O balão DET guarda só o
     ponto de brasa; o texto (nowrap) estouraria e seria cortado pelo overflow do
     bloco, então some. A caption principal continua descrevendo a foto. */
  @media (max-width:900px){
    .loop__det-tag{display:none}
  }
  @media (max-width:560px){
    .loop__node{flex-wrap:wrap;gap:.4rem 1rem}
    .loop__node-role{margin-left:0;text-align:left;flex-basis:100%}
  }

  /* ============================================================
     DESKTOP = the horizontal pin. Only when JS booted (html.js)
     and the pin is live (:not(.is-native)); otherwise the base
     vertical layout above stands as the static fallback.
     ============================================================ */
  @media (min-width:901px){
    :global(html.js) .loop:not(.is-native){
      height:100svh;min-height:600px;padding:0;
    }
    /* backdrop becomes full-bleed cinema behind the moving track */
    :global(html.js) .loop:not(.is-native) .loop__bg{
      position:absolute;inset:0;z-index:0;
      width:auto;max-width:none;margin:0;aspect-ratio:auto;
      clip-path:none;border-radius:0;box-shadow:none;
    }
    :global(html.js) .loop:not(.is-native) .loop__det{top:44%;right:34%}

    /* the track: one tall row, wider than the viewport, centred vertically */
    :global(html.js) .loop:not(.is-native) .loop__track{
      flex-direction:row;align-items:center;flex-wrap:nowrap;
      width:max-content;max-width:none;margin:0;
      height:100svh;min-height:600px;
      gap:clamp(1rem,2.4vw,2.4rem);
      padding-inline:max(var(--pad),env(safe-area-inset-left)) max(var(--pad),env(safe-area-inset-right));
    }

    :global(html.js) .loop:not(.is-native) .loop__intro{
      flex:0 0 clamp(340px,32vw,520px);
      background:linear-gradient(120deg,rgba(11,13,15,.66),rgba(11,13,15,.28));
    }
    :global(html.js) .loop:not(.is-native) .loop__title{
      font-size:clamp(2.2rem,3vw,3.4rem);max-width:none;
    }
    :global(html.js) .loop:not(.is-native) .loop__lede{max-width:40ch}

    /* the loop reads left-to-right, generously spaced for the scrub */
    :global(html.js) .loop:not(.is-native) .loop__flow{
      flex-direction:row;align-items:center;flex:0 0 auto;
    }
    :global(html.js) .loop:not(.is-native) .loop__node{
      flex:0 0 clamp(210px,20vw,266px);
      flex-direction:column;align-items:flex-start;justify-content:space-between;
      min-height:clamp(220px,42vh,320px);
      padding:1.5rem 1.5rem 1.6rem;gap:1rem;--chf:22px;
    }
    :global(html.js) .loop:not(.is-native) .loop__node-name{
      font-size:clamp(1.8rem,2.3vw,2.4rem);
    }
    :global(html.js) .loop:not(.is-native) .loop__node-role{
      margin-left:0;text-align:left;font-size:.92rem;max-width:22ch;
    }

    /* connector becomes the horizontal trace between modules */
    :global(html.js) .loop:not(.is-native) .loop__link{
      flex:0 0 clamp(56px,8vw,150px);width:auto;height:auto;min-height:1px;align-self:center;
    }
    :global(html.js) .loop:not(.is-native) .loop__link::before{
      top:50%;bottom:auto;left:0;right:0;width:auto;height:1px;transform:translateY(-50%);
      background:linear-gradient(90deg,var(--line),var(--muted-dim),var(--line));
    }

    :global(html.js) .loop:not(.is-native) .loop__loopback{
      flex:0 0 clamp(158px,16vw,214px);align-self:center;
    }

    :global(html.js) .loop:not(.is-native) .loop__panel{
      flex:0 0 clamp(320px,30vw,480px);
      background:rgba(20,23,26,.86);
    }
  }

  /* very short landscape: keep the pinned stage usable */
  @media (min-width:901px) and (max-height:560px){
    :global(html.js) .loop:not(.is-native),
    :global(html.js) .loop:not(.is-native) .loop__track{min-height:460px}
    :global(html.js) .loop:not(.is-native) .loop__node{min-height:300px}
  }

  /* reduced motion: no live pulse, static readable stack (base layout stands) */
  @media (prefers-reduced-motion:reduce){
    .loop__live{animation:none}
  }
</style>
