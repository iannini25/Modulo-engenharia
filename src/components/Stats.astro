---
import { site } from '../data/site';
const hasIllustrative = site.metrics.some((m) => m.illustrative);
---
<section id="numeros" class="section stats">
  <div class="wrap stats__grid">
    {site.metrics.map((m) => (
      <div class="stat" data-reveal>
        <span class="stat__num" data-count={m.value} data-prefix={m.prefix} data-suffix={m.suffix}>0</span>
        <span class="stat__lbl">
          <Fragment set:html={m.label.replace(' ', '<br />')} />{m.illustrative && <sup>*</sup>}
        </span>
      </div>
    ))}
  </div>
  {hasIllustrative && (
    <p class="wrap stats__note mono"><sup>*</sup>&nbsp;Valores ilustrativos — a confirmar com a Módulo Engenharia.</p>
  )}
</section>
