---
import { site } from '../data/site';
const items = [...site.nav, { label: 'Contato', href: '/contato' }];
---
<div class="menu" id="menu" aria-hidden="true" inert>
  <nav class="menu__links">
    {items.map((n, i) => (
      <a href={n.href}>{n.label}</a>
    ))}
  </nav>
  <a href="/contato" class="btn btn--solid btn--lg menu__cta"><span class="btn__t">Iniciar um projeto</span><span class="btn-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
</div>
