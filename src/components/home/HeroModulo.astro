---
// Hero: the ONLY preserved effect, the scroll-scrubbed frame sequence of the
// red offshore platform (canvas, cover-drawn, eased). New dark layout: the
// promise in giant Koralle anchored lower-left in an L-corner frame, wordmark
// bleeding off the top, mono HUD in the corners with a live status dot.
import { copy } from '../../data/home';
import { ignite } from '../../lib/ignite';
const h = copy.hero;
const FRAME_COUNT = 121;
const FRAME_COUNT_MOBILE = 70;
const heroAlt =
  'Plataforma de petróleo offshore ao entardecer, representação ilustrativa do segmento offshore atendido pela Módulo Engenharia';
---
<section
  id="inicio"
  class="hero"
  data-hero
  data-frame-count={FRAME_COUNT}
  data-frame-count-mobile={FRAME_COUNT_MOBILE}
  data-frames-desktop="/frames/desktop/f_"
  data-frames-mobile="/frames/mobile/f_"
  data-frame-ext=".webp"
  data-frame-pad="3"
>
  <div class="hero__stage">
    <div class="hero__media" id="heroMedia">
      <picture>
        <source media="(max-width: 640px)" type="image/webp" srcset="/hero/platform-portrait.webp" />
        <source media="(max-width: 640px)" srcset="/hero/platform-portrait.jpg" />
        <source type="image/webp" srcset="/hero/platform.webp" />
        <img src="/hero/platform.jpg" alt={heroAlt} fetchpriority="high" width="2400" height="1340" />
      </picture>
    </div>

    <canvas class="hero__canvas" id="heroCanvas" aria-hidden="true"></canvas>
    <div class="hero__grade" aria-hidden="true"></div>

    <!-- HUD telemetry (sits below the fixed nav, over the sky) -->
    <div class="hero__hud" aria-hidden="true">
      <span class="hud hud--tl"><i class="hud__dot"></i>{h.hudStateLabel}</span>
      <span class="hud hud--tr">{h.hudCornerRight}</span>
    </div>

    <div class="hero__inner">
      <div class="hero__lead lcorners lcorners--ember">
        <p class="u-kicker hero__kicker" data-reveal><i></i>{h.kicker}</p>
        <h1 class="hero__title u-display" data-reveal set:html={ignite(h.headline, h.palavraBrasa)}></h1>
        <p class="hero__sub" data-reveal>{h.subhead}</p>
        <div class="hero__cta" data-reveal>
          <a href="#contato" class="btn btn--ember btn--lg" data-magnetic>
            {h.cta}
            <svg class="arw" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <p class="hero__micro u-mono">{h.ctaMicrocopy}</p>
        </div>
      </div>
    </div>

    <div class="hero__cue" aria-hidden="true"><span class="u-mono">ROLE</span><i></i></div>
  </div>
</section>

<style>
  .hero{position:relative;height:100vh;height:100svh;min-height:600px;background:var(--bg)}
  html.js .hero{height:240svh}
  .hero__stage{position:sticky;top:0;height:100vh;height:100svh;min-height:600px;overflow:hidden}
  .hero__media{position:absolute;inset:0}
  .hero__media picture{display:block;width:100%;height:100%}
  .hero__media img{width:100%;height:100%;object-fit:cover;object-position:58% 42%}
  .hero__canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
  .hero__grade{position:absolute;inset:0;pointer-events:none;background:
    linear-gradient(90deg,rgba(8,10,12,.86) 0%,rgba(8,10,12,.55) 30%,rgba(8,10,12,.12) 56%,transparent 74%),
    linear-gradient(180deg,rgba(8,10,12,.5) 0%,transparent 20%,transparent 52%,rgba(8,10,12,.82) 100%)}

  .hero__hud{position:absolute;inset:0;pointer-events:none;color:var(--muted)}
  .hud{position:absolute;top:clamp(72px,11vh,108px);font-family:var(--mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase}
  .hud--tl{left:clamp(16px,3vw,38px);display:inline-flex;align-items:center;gap:.5rem;color:var(--ink)}
  .hud--tr{right:clamp(16px,3vw,38px);text-align:right;max-width:44vw}
  .hud__dot{width:7px;height:7px;background:var(--accent);clip-path:var(--clip-diamond);box-shadow:0 0 0 0 rgba(var(--accent-rgb),.6);animation:pulse 1.8s var(--ease) infinite}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(var(--accent-rgb),.6)}70%{box-shadow:0 0 0 8px rgba(var(--accent-rgb),0)}100%{box-shadow:0 0 0 0 rgba(var(--accent-rgb),0)}}

  .hero__inner{position:absolute;inset:0;z-index:3;display:flex;align-items:flex-end;
    padding:0 max(var(--pad),env(safe-area-inset-left)) clamp(8vh,14vh,150px);pointer-events:none}
  .hero__lead{max-width:min(760px,68%);pointer-events:auto;padding:clamp(18px,2.2vw,30px) 0 0 clamp(18px,2.4vw,32px)}
  .hero__kicker{color:var(--ink);margin-bottom:1.5rem}
  .hero__title{font-size:clamp(2.7rem,7vw,6.6rem);line-height:.98;letter-spacing:-.025em;color:var(--ink);text-wrap:balance}
  .hero__sub{margin-top:1.6rem;max-width:48ch;color:var(--ink);opacity:.9;font-size:clamp(1.02rem,1.4vw,1.24rem);line-height:1.5}
  .hero__cta{margin-top:2rem;display:flex;align-items:center;gap:1.4rem;flex-wrap:wrap}
  .hero__micro{font-size:.7rem;letter-spacing:.04em;color:var(--muted);max-width:26ch;text-transform:none}

  .hero__cue{position:absolute;left:50%;bottom:5vh;transform:translateX(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;gap:.5rem;color:var(--muted)}
  .hero__cue span{font-size:.6rem;letter-spacing:.24em}
  .hero__cue i{width:1px;height:34px;background:linear-gradient(var(--muted),transparent);position:relative;overflow:hidden}
  .hero__cue i::after{content:"";position:absolute;top:-40%;left:0;width:100%;height:40%;background:var(--accent);animation:cue 1.9s var(--ease) infinite}
  @keyframes cue{0%{top:-40%}100%{top:140%}}

  @media (max-width:640px){.hero__media img{object-position:52% 44%}}
  @media (max-width:900px){
    .hero__lead{max-width:none}
    .hero__inner{padding-bottom:max(11vh,calc(env(safe-area-inset-bottom) + 96px))}
  }
  @media (max-width:720px){.hero__cue{display:none}}
  @media (orientation:landscape) and (max-height:560px){
    .hero,.hero__stage{min-height:440px}
    html.js .hero{height:160svh}
    .hero__title{font-size:clamp(2rem,5vw,2.8rem)}
    .hero__inner{padding-bottom:max(28px,env(safe-area-inset-bottom))}
    .hero__cue{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    html.js .hero{height:100svh;min-height:560px}
    .hero__stage{position:relative}
  }
</style>
