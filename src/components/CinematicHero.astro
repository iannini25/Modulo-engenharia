---
// Cinematic scroll hero v3 — "Plataforma no Entardecer".
// Primary: a scroll-scrubbed FRAME SEQUENCE on canvas (AI-generated video from the
// real offshore-3.jpg reference). Fallback (reduced-motion / no-JS / frames absent):
// the static golden-hour poster + a scroll camera move. Text sits LEFT, platform RIGHT.
// Honesty: the platform is an ILLUSTRATIVE representation of the offshore segment
// (AI-generated from a real reference), never claimed as "Módulo's platform".
// Still-mode: a true-4K render (5504px source) with a scroll camera move.
// (The 1080p AI video was too low-res for a 4K hero, so we use the 4K still.)
const FRAME_COUNT = 0;
const FRAME_COUNT_MOBILE = 0;
const heroAlt =
  'Plataforma de petróleo offshore em mar aberto ao entardecer — representação do segmento offshore atendido pela Módulo Engenharia (imagem ilustrativa)';
---
<section
  id="inicio"
  class="hero hero--platform"
  data-hero-mode="still"
  data-frame-count={FRAME_COUNT}
  data-frame-count-mobile={FRAME_COUNT_MOBILE}
>
  <div class="hero__stage">
    <div class="hero__media" id="heroMedia">
      <picture>
        <source media="(max-width: 640px)" type="image/webp" srcset="/hero/platform-portrait.webp" />
        <source media="(max-width: 640px)" srcset="/hero/platform-portrait.jpg" />
        <source type="image/webp" srcset="/hero/platform.webp" />
        <img src="/hero/platform.jpg" alt={heroAlt} fetchpriority="high" width="2400" height="1340" />
      </picture>
    </div>

    <canvas class="hero__canvas" id="heroCanvas" aria-hidden="true"></canvas>
    <div class="hero__grade hero__grade--left"></div>
    <div class="hero__grain" aria-hidden="true"></div>

    <div class="hero__hud hero__hud--quiet" aria-hidden="true">
      <span class="hud__corner hud__corner--tl"></span>
      <span class="hud__corner hud__corner--tr"></span>
      <span class="hud__corner hud__corner--bl"></span>
      <span class="hud__corner hud__corner--br"></span>
      <span class="hud__rec"><i></i>SISTEMA ATIVO</span>
    </div>

    <div class="hero__inner">
      <div class="hero__lead">
        <p class="hero__eyebrow" data-reveal>
          <span class="dot"></span>ENGENHARIA · AUTOMAÇÃO · MANUTENÇÃO
        </p>
        <h1 class="hero__title">
          <span class="line" data-reveal>Onde falhar</span>
          <span class="line" data-reveal>não é <em>opção</em>.</span>
        </h1>
        <p class="hero__lede" data-reveal>
          Automação e engenharia que elevam produtividade e segurança onde o
          erro custa caro — da mina ao mar aberto.
        </p>
        <div class="hero__actions" data-reveal>
          <a href="#contato" class="btn btn--solid btn--lg" data-magnetic>Iniciar um projeto<svg viewBox="0 0 24 24" class="ico-arrow"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        </div>
      </div>
    </div>

    <div class="hero__cue" aria-hidden="true"><span>ROLE PARA EXPLORAR</span><i></i></div>
  </div>
</section>
