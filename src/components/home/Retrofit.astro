---
// Retrofit: "Rev A para Rev B, modernização de ativos".
// A drawing-revision comparator (ownable convention): the same pátio asset
// annotated in two states, REV A (as-is, graphite) flanking left and REV B
// (modernized, the ember) flanking right, with the shared recuperadora-duo
// asset in a chamfered module at the centre. A CSS/SVG revision cloud in
// accent draws over the delta region (GSAP DrawSVG via [data-draw-line]),
// and the revisionCloud[] deltas read as mono leader-lines. empilhadeira-duo
// rides in as a smaller offset canted chip. Red is spent only on the delta.
import { copy } from '../../data/home';
const s = copy.retrofit;
---
<section id="retrofit" class="rf sec" aria-labelledby="retrofit-title">
  <div class="wrap">
    <header class="sec__head rf__head" data-reveal>
      <p class="u-kicker"><i></i>{s.kicker}</p>
      <h2 id="retrofit-title" class="rf__title u-display u-l">{s.headline}</h2>
      <p class="u-lede">{s.oneLiner}</p>
    </header>

    <div class="rf__device">
      <div class="rf__grid">

        <!-- centre: the shared asset under modernization + revision cloud -->
        <div class="rf__plate lcorners" data-reveal>
          <div class="rf__asset imod imod--chf" data-parallax="0.1">
            <img
              src="/assets/img/recuperadora-duo.webp"
              width="430" height="287" loading="lazy" decoding="async"
              alt="Recuperadora de pátio em tratamento duotone grafite, ativo de mineração no processo de modernização"
            />
          </div>

          <!-- revision cloud (accent line-art) marking the delta region -->
          <svg class="rf__cloud" viewBox="0 0 240 150" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
            <path
              data-draw-line
              d="M24 24 a16 16 0 0 1 32 0 a16 16 0 0 1 32 0 a16 16 0 0 1 32 0 a16 16 0 0 1 32 0 a16 16 0 0 1 32 0 a16 16 0 0 1 32 0 a17 17 0 0 1 0 34 a17 17 0 0 1 0 34 a17 17 0 0 1 0 34 a16 16 0 0 1 -32 0 a16 16 0 0 1 -32 0 a16 16 0 0 1 -32 0 a16 16 0 0 1 -32 0 a16 16 0 0 1 -32 0 a16 16 0 0 1 -32 0 a17 17 0 0 1 0 -34 a17 17 0 0 1 0 -34 a17 17 0 0 1 0 -34 Z"
            />
          </svg>
          <span class="rf__delta-mark u-mono" aria-hidden="true">Δ REV B</span>

          <p class="rf__plate-cap u-mono"><i aria-hidden="true"></i>{s.imageCaption}</p>

          <!-- second pátio asset: smaller offset canted chip -->
          <figure class="rf__chip">
            <div class="rf__chip-frame">
              <div class="rf__chip-img imod imod--cant">
                <img
                  src="/assets/img/empilhadeira-duo.webp"
                  width="430" height="323" loading="lazy" decoding="async"
                  alt="Empilhadeira de pátio em duotone grafite, segundo ativo da frota em modernização"
                />
              </div>
            </div>
            <figcaption class="rf__chip-label u-mono"><i aria-hidden="true"></i>Empilhadeira de pátio</figcaption>
          </figure>
        </div>

        <!-- REV A: asset as-is (graphite, the before) -->
        <figure class="rf__state rf__state--a" data-reveal>
          <p class="rf__flag u-mono"><i class="rf__diamond"></i>{s.revA.label}</p>
          <figcaption class="rf__cap">{s.revA.caption}</figcaption>
          <span class="rf__leader rf__leader--a" aria-hidden="true"></span>
        </figure>

        <!-- REV B: modernized (the ember, the after) -->
        <figure class="rf__state rf__state--b" data-reveal>
          <p class="rf__flag u-mono"><i class="rf__diamond rf__diamond--on"></i><span class="u-ember">{s.revB.label}</span></p>
          <figcaption class="rf__cap">{s.revB.caption}</figcaption>
          <span class="rf__leader rf__leader--b" aria-hidden="true"></span>
        </figure>

        <!-- revision cloud content: the deltas as mono leader-lines -->
        <aside class="rf__deltas" data-reveal aria-label="Nuvem de revisão, o que entra na Rev B">
          <p class="rf__deltas-h u-mono"><span class="rf__deltas-tri" aria-hidden="true"></span>Nuvem de revisão, o que entra na REV B</p>
          <ul class="rf__delta-list">
            {s.revisionCloud.map((d: string) => (
              <li class="u-mono">{d}</li>
            ))}
          </ul>
        </aside>

      </div>
    </div>
  </div>
</section>

<style>
  .rf{position:relative;background:var(--bg)}
  .rf__head{max-width:760px}
  .rf__title{margin-top:1rem}

  .rf__device{position:relative;margin-top:clamp(2.5rem,5vw,4rem)}
  .rf__grid{
    display:grid;
    grid-template-columns:minmax(190px,0.9fr) minmax(0,1.55fr) minmax(190px,0.9fr);
    grid-template-rows:auto auto;
    gap:clamp(1.4rem,2.6vw,2.6rem);
    align-items:center;
  }
  .rf__plate{grid-column:2;grid-row:1;justify-self:center;width:100%;max-width:600px}
  .rf__state--a{grid-column:1;grid-row:1;justify-self:end}
  .rf__state--b{grid-column:3;grid-row:1;justify-self:start}
  .rf__deltas{grid-column:1 / -1;grid-row:2;margin-top:clamp(1.2rem,2vw,2rem)}

  /* ---- centre plate: the shared asset ---- */
  .rf__plate{position:relative}
  .rf__asset{position:relative;aspect-ratio:3 / 2;background:var(--surface);
    box-shadow:inset 0 1px 0 rgba(236,238,241,.06)}
  .rf__asset img{position:absolute;top:-9%;left:0;width:100%;height:118%;object-fit:cover;object-position:52% 46%}

  .rf__plate-cap{position:absolute;left:0;right:0;bottom:0;z-index:3;pointer-events:none;
    display:flex;align-items:center;gap:.55rem;
    padding:1.6rem clamp(.7rem,1.4vw,1.1rem) .7rem;
    font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);
    background:linear-gradient(to top,rgba(8,10,12,.86),rgba(8,10,12,.45) 55%,transparent)}
  .rf__plate-cap i{width:7px;height:7px;flex:none;background:var(--muted-dim);clip-path:var(--clip-diamond)}

  /* revision cloud + delta stamp (the only red on the image) */
  .rf__cloud{position:absolute;top:5%;right:4%;width:46%;max-width:270px;height:auto;z-index:2;pointer-events:none;overflow:visible}
  .rf__cloud path{fill:none;stroke:var(--accent);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;
    vector-effect:non-scaling-stroke;filter:drop-shadow(0 0 5px rgba(var(--accent-rgb),.32))}
  .rf__delta-mark{position:absolute;top:6%;right:8%;z-index:3;pointer-events:none;
    font-weight:600;font-size:.62rem;letter-spacing:.16em;color:var(--accent)}

  /* second asset: smaller offset canted chip */
  .rf__chip{position:absolute;right:-3%;bottom:-8%;width:34%;max-width:196px;z-index:4;margin:0}
  .rf__chip-frame{clip-path:var(--clip-cant);background:var(--line);padding:1.5px}
  .rf__chip-img{aspect-ratio:4 / 3;background:var(--surface)}
  .rf__chip-img img{width:100%;height:100%;object-fit:cover}
  .rf__chip-label{margin-top:.55rem;display:flex;align-items:center;gap:.4rem;
    font-size:.56rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .rf__chip-label i{width:6px;height:6px;flex:none;background:var(--muted-dim);clip-path:var(--clip-diamond)}
  /* the REV B flag sits on --surface-2: lift its ember text to accent-hi for AA */
  .rf__state--b .u-ember{color:var(--accent-hi)}

  /* ---- REV A / REV B annotation states ---- */
  .rf__state{position:relative;margin:0;display:flex;flex-direction:column;gap:.7rem;
    max-width:300px;width:100%;
    background:var(--surface);border:var(--hair) solid var(--line);
    clip-path:var(--clip-chf);--chf:18px;
    padding:clamp(1rem,1.5vw,1.35rem);
    box-shadow:inset 0 1px 0 rgba(236,238,241,.05);
    transition:transform .4s var(--ease),border-color .4s var(--ease)}
  .rf__state--b{background:var(--surface-2)}
  .rf__flag{display:inline-flex;align-items:center;gap:.55rem;font-size:.74rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}
  .rf__state--b .rf__flag{color:var(--ink)}
  .rf__diamond{width:9px;height:9px;flex:none;background:var(--muted-dim);clip-path:var(--clip-diamond)}
  .rf__diamond--on{background:var(--accent);box-shadow:0 0 10px rgba(var(--accent-rgb),.5)}
  .rf__cap{font-family:var(--mono);font-size:.68rem;line-height:1.55;letter-spacing:.02em;color:var(--muted)}
  .rf__state--b .rf__cap{color:var(--ink)}

  /* drafting leader ticks pointing from each state toward the plate */
  .rf__leader{position:absolute;top:50%;height:var(--hair);width:clamp(14px,2vw,26px);background:var(--line)}
  .rf__leader--a{right:calc(-1 * clamp(14px,2vw,26px));background:linear-gradient(90deg,var(--line),transparent)}
  .rf__leader--b{left:calc(-1 * clamp(14px,2vw,26px));background:linear-gradient(90deg,transparent,var(--accent))}

  /* ---- deltas as leader-lines ---- */
  .rf__deltas{border-top:var(--hair) solid var(--line);padding-top:clamp(1.1rem,1.8vw,1.6rem)}
  .rf__deltas-h{display:flex;align-items:center;gap:.6rem;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:1.1rem}
  .rf__deltas-tri{width:0;height:0;flex:none;
    border-left:6px solid transparent;border-right:6px solid transparent;border-bottom:10px solid var(--accent);
    filter:drop-shadow(0 0 6px rgba(var(--accent-rgb),.4))}
  .rf__delta-list{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem 2.4rem;max-width:820px}
  .rf__delta-list li{position:relative;padding-left:1.7rem;font-size:.76rem;letter-spacing:.02em;color:var(--muted);line-height:1.5}
  .rf__delta-list li::before{content:"";position:absolute;left:0;top:.62em;width:1.1rem;height:var(--hair);background:var(--accent);opacity:.85}

  @media (hover:hover) and (pointer:fine){
    .rf__state:hover{transform:translateY(-3px);border-color:var(--muted-dim)}
    .rf__state--b:hover{border-color:var(--accent)}
  }

  /* ============================ RESPONSIVE ============================ */
  @media (max-width:900px){
    .rf__grid{grid-template-columns:1fr;grid-template-rows:none;gap:clamp(1rem,3vw,1.6rem);align-items:stretch}
    .rf__plate,.rf__state--a,.rf__state--b,.rf__deltas{grid-column:auto;grid-row:auto;justify-self:stretch}
    .rf__plate{max-width:560px;margin-inline:auto}
    .rf__state{max-width:none}
    .rf__leader{display:none}
    /* revision cloud collapses to the deltas list on mobile */
    .rf__cloud,.rf__delta-mark{display:none}
    /* chip drops out of overlap into normal flow, still offset to the right */
    .rf__chip{position:static;width:min(58%,220px);margin:1.1rem 0 0 auto;right:auto;bottom:auto}
    .rf__deltas{margin-top:.6rem}
  }

  @media (max-width:560px){
    .rf__delta-list{grid-template-columns:1fr;gap:.7rem}
    .rf__chip{width:min(72%,220px)}
    .rf__cap{font-size:.7rem}
  }

  @media (prefers-reduced-motion:reduce){
    .rf__state{transition:none}
  }
</style>
