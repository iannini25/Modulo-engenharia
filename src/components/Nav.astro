---
import Brand from './Brand.astro';
import { site } from '../data/site';
import { greetingURL } from '../lib/wa';
const wa = greetingURL(site.contact.whatsappDigits);
const { pathname } = Astro.url;
const isHome = pathname === '/';
const isActive = (href: string) => pathname === href || pathname === href + '/';
---
<header class={`nav${isHome ? '' : ' nav--solid'}`} id="nav">
  <Brand href="/" />

  <nav class="nav__links" aria-label="Navegação principal">
    {site.nav.map((n) => (
      <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
    ))}
  </nav>

  <a href={wa} class="btn btn--solid nav__cta" target="_blank" rel="noopener"><span class="btn__t">Falar com a engenharia</span><span class="btn-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>

  <button class="nav__burger" id="burger" aria-label="Abrir menu" aria-expanded="false">
    <span></span><span></span>
  </button>
</header>
