---
// Servicos: "Seis servicos, um sistema que se encaixa" (#servicos).
// Prova de capacidade ponta a ponta: os 6 serviços reais como MÓDULOS chanfrados
// de footprints deliberadamente DESIGUAIS que se entrelaçam num mosaico (nunca uma
// grade de losangos iguais). Um módulo-âncora maior traz o painel duotone com um
// balão DET apontando o LED de estado (o único ponto de brasa da região da foto).
// Só marcação de motion (data-reveal / data-parallax / data-count); nada de JS aqui.
import { copy } from '../../data/home';
import DMark from './DMark.astro';

const s = copy['servicos-modulos'];
// alterna a direção do chanfro para que os módulos leiam como peças que encaixam
const clip = (i: number): string => (i % 2 === 0 ? 'mod' : 'mod--tr');
const panelAlt =
  'Painéis elétricos de controle industrial com LEDs de estado, em tratamento duotone grafite frio';
---
<section id="servicos" class="svc sec" aria-labelledby="svc-title">
  <div class="wrap">
    <!-- cabeçalho da seção -->
    <div class="svc-head sec__head">
      <div class="svc-head__lead">
        <p class="u-kicker" data-reveal><i></i>{s.kicker}</p>
        <h2 id="svc-title" class="svc-head__title u-display u-l" data-reveal>{s.headline}</h2>
        <p class="u-lede" data-reveal>{s.subhead}</p>
        <p class="svc-meta u-mono" data-reveal>
          <span class="svc-meta__n" data-count="6" data-prefix="0">06</span>
          <span>Serviços</span>
          <span class="svc-meta__x" aria-hidden="true">/</span>
          <span>Um responsável, não seis fornecedores</span>
        </p>
      </div>
      <div class="svc-head__mark" data-reveal aria-hidden="true">
        <DMark draw={true} />
        <span class="svc-head__marktxt u-mono">SISTEMA MÓDULO</span>
      </div>
    </div>

    <!-- mosaico de módulos: footprints desiguais que travam -->
    <div class="svc-grid">
      <!-- módulo-âncora: painel duotone + balão DET no LED de estado -->
      <div class="svc-anchor lcorners" data-reveal>
        <div class="imod imod--chf svc-anchor__img" data-parallax="0.1">
          <img src="/assets/img/paineis-duo.webp" alt={panelAlt} loading="lazy" decoding="async" />
        </div>
        <span class="det svc-det">DET A / <b>LED DE ESTADO</b></span>
        <span class="svc-detlead" aria-hidden="true"></span>
        <p class="svc-anchor__cap u-mono">PAINEL DE CONTROLE / LEDS DE ESTADO</p>
      </div>

      <!-- os 6 módulos: no mobile correm num carrossel scroll-snap; de 601px pra cima o
           track vira display:contents e eles voltam a ser peças do mosaico -->
      <div class="svc-track">
        {s.modules.map((m: any, i: number) => (
          <article
            class:list={['svc-mod', `m0${i + 1}`, clip(i)]}
            data-reveal
            style={`transition-delay:${i * 70}ms`}
          >
            <header class="svc-mod__top">
              <span class="svc-mod__tag u-mono"><i class="svc-dot" aria-hidden="true"></i>{m.tag}</span>
              <span class="svc-mod__verb u-mono">{m.verb}</span>
            </header>
            <div class="svc-mod__body">
              <h3 class="svc-mod__name u-display">{m.name}</h3>
              <p class="svc-mod__spec u-mono">{m.spec}</p>
              <p class="svc-mod__value">{m.value}</p>
            </div>
            <div class="svc-mod__more">
              <p>{m.hover}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .svc{position:relative;background:var(--bg)}

  /* ---------- cabeçalho ---------- */
  .svc-head{display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;max-width:none}
  .svc-head__lead{max-width:64ch}
  .svc-head__title{margin-top:1.1rem;text-wrap:balance}
  .svc-meta{margin-top:1.6rem;display:flex;align-items:center;gap:.7rem;flex-wrap:wrap;
    font-size:.72rem;color:var(--muted);text-transform:uppercase}
  .svc-meta__n{color:var(--ink);font-weight:600;letter-spacing:.04em}
  .svc-meta__x{color:var(--muted-dim)}

  .svc-head__mark{display:flex;flex-direction:column;align-items:flex-end;gap:.55rem;padding-bottom:.4rem;flex:none;--dmark-w:46px}
  .svc-head__marktxt{font-size:.62rem;letter-spacing:.16em;color:var(--muted)}

  /* ---------- mosaico (mobile-first: âncora full-width + carrossel dos módulos) ---------- */
  .svc-grid{display:grid;grid-template-columns:1fr;gap:clamp(12px,3vw,16px)}

  /* mobile: os módulos NÃO viram trem de card, correm num carrossel scroll-snap
     (mesmo padrão de ProvaCampo). De 601px pra cima o track some (display:contents)
     e os .svc-mod voltam a ser itens diretos do grid do mosaico. */
  .svc-track{display:flex;gap:12px;
    overflow-x:auto;scroll-snap-type:x mandatory;overscroll-behavior-x:contain;
    margin-inline:calc(-1 * var(--pad));padding-inline:var(--pad);padding-bottom:.4rem;
    scrollbar-width:none;-webkit-overflow-scrolling:touch}
  .svc-track::-webkit-scrollbar{display:none}
  .svc-track > .svc-mod{flex:0 0 82%;scroll-snap-align:start}

  /* ---------- módulo-âncora (imagem do painel) ---------- */
  .svc-anchor{position:relative;min-height:clamp(220px,58vw,320px);--chf:clamp(24px,3vw,40px)}
  .svc-anchor__img{position:absolute;inset:0;background:var(--surface);--chf:clamp(24px,3vw,40px)}
  .svc-anchor__img img{position:absolute;left:0;top:-8%;width:100%;height:116%;object-fit:cover;
    filter:contrast(1.04) brightness(.94);transition:filter .6s var(--ease)}
  .svc-anchor__cap{position:absolute;left:clamp(16px,2.4vw,26px);bottom:clamp(14px,2vw,22px);z-index:3;
    font-size:.6rem;letter-spacing:.12em;color:var(--muted);
    text-shadow:0 1px 10px rgba(8,10,12,.9)}
  .svc-det{top:16%;left:44%}
  .svc-detlead{position:absolute;top:calc(16% + 15px);left:calc(44% + 2px);z-index:3;
    width:1px;height:clamp(32px,5vw,56px);
    background:linear-gradient(180deg,var(--accent),transparent);
    transform-origin:top center;transform:rotate(26deg);opacity:.85}

  /* ---------- módulo de serviço ---------- */
  .svc-mod{position:relative;overflow:hidden;background:var(--surface);
    border:var(--hair) solid var(--line);
    --chf:clamp(16px,1.9vw,26px);
    padding:clamp(22px,2vw,30px);
    display:flex;flex-direction:column;justify-content:space-between;gap:1.4rem;
    box-shadow:inset 0 1px 0 rgba(236,238,241,.05);
    transition:border-color .35s var(--ease),transform .45s var(--ease),
      background .35s var(--ease),filter .45s var(--ease)}

  .svc-mod__top{display:flex;align-items:center;justify-content:space-between;gap:.4rem 1rem;flex-wrap:wrap}
  .svc-mod__tag{display:inline-flex;align-items:center;gap:.55rem;font-size:.7rem;color:var(--muted);letter-spacing:.1em;white-space:nowrap}
  .svc-dot{width:7px;height:7px;flex:none;background:var(--muted-dim);clip-path:var(--clip-diamond);
    transition:background .35s var(--ease)}
  .svc-mod__verb{font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}

  .svc-mod__body{display:flex;flex-direction:column;gap:.5rem}
  .svc-mod__name{font-size:clamp(1.08rem,1.4vw,1.5rem);line-height:1.04;color:var(--ink)}
  .svc-mod__spec{font-size:.64rem;letter-spacing:.1em;color:var(--muted);text-transform:uppercase}
  .svc-mod__value{font-size:.94rem;line-height:1.48;color:var(--muted);max-width:44ch;margin-top:.25rem}

  /* detalhe do hover: escopo do serviço */
  .svc-mod__more{color:var(--ink)}
  .svc-mod__more p{font-size:.86rem;line-height:1.52;max-width:46ch}

  /* módulo-âncora e o serviço-carro-chefe ocupam mais em telas maiores */
  .m01 .svc-mod__name{font-size:clamp(1.2rem,1.7vw,1.75rem)}

  /* ---------- tablet: duas colunas, âncora e MOD 01 em faixa larga ---------- */
  @media (min-width:601px){
    /* track vira transparente: os .svc-mod voltam a ser itens diretos do grid */
    .svc-track{display:contents}
    .svc-grid{grid-template-columns:repeat(2,1fr);gap:clamp(12px,1.4vw,16px)}
    .svc-anchor{grid-column:1 / -1;min-height:clamp(260px,40vw,360px)}
    .m01{grid-column:1 / -1}
  }

  /* ---------- desktop: mosaico entrelaçado de footprints desiguais ---------- */
  @media (min-width:1025px){
    .svc-grid{grid-template-columns:repeat(6,1fr);
      /* min height keeps the interlock; auto lets dense cards grow instead of clipping */
      grid-auto-rows:minmax(clamp(166px,13.5vw,198px),auto);
      gap:clamp(12px,.9vw,16px)}
    .svc-anchor{grid-column:1 / 4;grid-row:1 / 3;min-height:0}
    .m01{grid-column:4 / 7;grid-row:1 / 2}
    .m02{grid-column:4 / 6;grid-row:2 / 3}
    .m03{grid-column:5 / 6;grid-row:3 / 4}
    .m04{grid-column:3 / 5;grid-row:3 / 4}
    .m05{grid-column:1 / 3;grid-row:3 / 4}
    .m06{grid-column:6 / 7;grid-row:2 / 4}
    .svc-mod{gap:1rem}
  }

  /* ---------- hover apenas em ponteiro fino: revela o escopo + acende a borda ---------- */
  @media (hover:hover) and (pointer:fine){
    .svc-mod__more{position:absolute;left:0;right:0;bottom:0;z-index:2;
      padding:clamp(20px,1.9vw,28px);
      background:var(--surface-2);border-top:var(--hair) solid var(--accent);
      opacity:0;transform:translateY(14px);pointer-events:none;
      transition:opacity .35s var(--ease),transform .4s var(--ease)}
    .svc-mod:hover,.svc-mod:focus-within{
      border-color:var(--accent);transform:translateY(-3px);
      filter:drop-shadow(0 0 20px rgba(var(--accent-rgb),.24))}
    .svc-mod:hover .svc-dot,.svc-mod:focus-within .svc-dot{background:var(--accent)}
    .svc-mod:hover .svc-mod__more,.svc-mod:focus-within .svc-mod__more{opacity:1;transform:none}
    /* imagem: brasa por filter (o transform pertence ao parallax do GSAP, nunca dois sistemas) */
    .svc-anchor:hover .svc-anchor__img img{filter:contrast(1.02) brightness(1.02)}
  }

  /* ---------- mobile: sem hover/parallax, tudo em fluxo, cada serviço uma linha ---------- */
  @media (max-width:600px){
    .svc-head{flex-direction:column;align-items:flex-start;gap:1.4rem}
    .svc-head__mark{flex-direction:row;align-items:center;align-self:flex-start}
    .svc-anchor{min-height:clamp(200px,62vw,280px)}
    .svc-mod{gap:1.1rem;min-height:44px}
    .svc-mod__more{margin-top:.2rem;padding-top:1rem;border-top:var(--hair) solid var(--line)}
  }

  /* telas estreitas: o card do carrossel abre um pouco (nunca vira grade de 2 col) */
  @media (max-width:420px){
    .svc-track > .svc-mod{flex-basis:88%}
  }

  /* parallax do painel desligado quando o usuário pediu menos movimento */
  @media (prefers-reduced-motion:reduce){
    .svc-anchor__img img{top:0;height:100%}
    .svc-mod:hover{transform:none;filter:none}
  }
</style>
